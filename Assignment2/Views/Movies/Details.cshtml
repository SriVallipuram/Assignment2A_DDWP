@using WebMatrix.Data
@{
    ViewBag.Title = "Details Page";
    ViewBag.FullWidth = true;   // the layout switches to a full-width container
}

<div class="d-flex justify-content-between align-items-center mb-3" ><h2>Details</h2>
    <a href="/Movies/Index/" class="btn btn-primary">Back</a>
</div>

@{
    var dtldb = Database.Open("dvdrental");
    // The movie id arrives in the URL: /Movies/Details?id=5
    int movie_id = Request.QueryString["id"].AsInt();

    // One row per movie; string_agg puts all its genres in one value (genre_name).
   
    var dtlsql = "SELECT movies.*, " +
                 "string_agg(genres.genre_name, ', ' ORDER BY genres.genre_name) AS genre_name " +
                 "FROM movies " +
                 "JOIN movie_genres ON movies.movie_id = movie_genres.movie_id " +
                 "JOIN genres ON movie_genres.genre_id = genres.genre_id " +
                 "WHERE movies.movie_id = @0 " +
                 "GROUP BY movies.movie_id";
    var dtldata = dtldb.Query(dtlsql, movie_id);

    // Cast for this movie (separate query)
    var castsql = "SELECT actors.first_name, actors.last_name, movie_actors.character_name " +
                  "FROM movie_actors " +
                  "JOIN actors ON movie_actors.actor_id = actors.actor_id " +
                  "WHERE movie_actors.movie_id = @0 " +
                  "ORDER BY actors.last_name";
    var castdata = dtldb.Query(castsql, movie_id);

    // Stores that hold a copy of this movie, with the number of copies (separate query)
    var storesql = "SELECT stores.store_name, stores.suburb, COUNT(copies.copy_id) AS copy_count " +
                   "FROM copies " +
                   "JOIN stores ON copies.store_id = stores.store_id " +
                   "WHERE copies.movie_id = @0 AND copies.retired = false " +
                   "GROUP BY stores.store_id, stores.store_name, stores.suburb " +
                   "ORDER BY stores.store_name";
    var storedata = dtldb.Query(storesql, movie_id);
    
    // Rental info of copies with stores & customers 
    // One row per store; details holds one text line per rented-out copy, separated by '|'
    var copysql = "SELECT stores.store_name, stores.suburb, COUNT(*) AS rented_count, " +
                  "string_agg('Copy # ' || copies.copy_id || ' - ' || customers.first_name || ' ' || customers.last_name || " +
                  "' (due ' || to_char(rental_items.due_date, 'DD/MM/YYYY') || ') - ' || customers.email || ' - ' || COALESCE(customers.phone, 'no phone'), '|' ORDER BY rental_items.due_date) AS details " +
                  "FROM copies " +
                  "JOIN rental_items ON copies.copy_id = rental_items.copy_id " +
                  "JOIN rentals ON rental_items.rental_id = rentals.rental_id " +
                  "JOIN customers ON rentals.customer_id = customers.customer_id " +
                  "JOIN stores ON copies.store_id = stores.store_id " +
                  "WHERE copies.movie_id = @0 AND rental_items.return_date IS NULL " +
                  "GROUP BY stores.store_id, stores.store_name, stores.suburb " +
                  "ORDER BY stores.store_name";
    var rentaldata = new List<dynamic>(dtldb.Query(copysql, movie_id));   // a List so we can check .Count

}

@foreach (var dtlrow in dtldata)
{
    <div class="card w-100">
        <img class="card-img-top" src="@Url.Content("~/Content/images/poster-placeholder.svg")" alt="@dtlrow.poster_filename" style="max-height: 400px; object-fit: cover;">
        <div class="card-body">
            <h1 class="card-title">@dtlrow.title</h1>
            <h4 class="card-title">@dtlrow.genre_name</h4>
            <h6 class="card-title">Year @dtlrow.release_year </h6>
            <h6 class="card-title">@dtlrow.runtime_minutes mintes</h6>
            <p class="card-text">@dtlrow.description</p>
        </div>
        <ul class="list-group list-group-flush">
            <li class="list-group-item">
                <div class="row">
                    <div class="col-md-6 fw-bolder">Cast &amp; Crew</div>
                    <div class="col-md-6">
                        <ul class="mb-0">
                            @foreach (var actor in castdata)
                            {
                                <li>@actor.first_name @actor.last_name as @actor.character_name</li>
                            }
                        </ul>
                    </div>
                </div>
                </li>
            
            <li class="list-group-item">
                <div class="row">
                    <div class="col-md-6 fw-bolder">Available Stores</div>
                    <div class="col-md-6">
                        <ul class="mb-0">
                            @foreach (var store in storedata)
                            {
                                <li>@store.store_name, @store.suburb (@store.copy_count available)</li>
                            }
                        </ul>
                    </div>
                </div>
            </li>
            
    <li class="list-group-item">
    <div class="row">
        <div class="col-md-6 fw-bolder">Rental Information</div>
        <div class="col-md-6">
            @if (rentaldata.Count == 0)
            {
                <p class="mb-0 text-muted">No copies currently rented out.</p>
            }
            <div class="row row-cols-1 row-cols-lg-2 g-2">
                @foreach (var rent in rentaldata)
                {
                    var lines = ((string)rent.details).Split('|');
                    <div class="col">
                        <div class="card h-100">
                            <div class="card-header fw-bold">@rent.store_name, @rent.suburb</div>
                            <div class="card-body py-2">
                                <p class="mb-1 small">@rent.rented_count rented out</p>
                                <ul class="mb-0 small">
                                    @foreach (var line in lines)
                                    {
                                        <li>@line</li>
                                    }
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
    </li>
        </ul>
        
    </div>
}

