@using WebMatrix.Data

@{
    ViewBag.Title = "Index Page";
    var db = Database.Open("dvdrental");

    // Values typed by the user (empty on first load)
    var titleSearch = "";
    var genreSearch = "";
    IEnumerable<dynamic> data;

    // All genres for the dropdown (separate from the movie results)
    var genres = db.Query("SELECT genre_name FROM genres ORDER BY genre_name");

    if (IsPost)
    {
        // A search was submitted: read the form values
        titleSearch = (Request.Form["titleSearch"] ?? "").Trim();
        genreSearch = (Request.Form["genreSearch"] ?? "").Trim();

        // An empty box means no value for this parameter.
        // string_agg joins all of a movie's genres into one value, one row per movie.
        // HAVING keeps a movie if ANY of its genres matches, while still showing all of them.
        var sql = @"SELECT movies.movie_id, movies.title, movies.description,
       movies.poster_filename, movies.rental_price,
       string_agg(genres.genre_name, ', ' ORDER BY genres.genre_name) AS genre_name
FROM movies
JOIN movie_genres ON movies.movie_id = movie_genres.movie_id
JOIN genres ON movie_genres.genre_id = genres.genre_id
WHERE (@0 = '' OR movies.title ILIKE '%' || @0 || '%')
GROUP BY movies.movie_id, movies.title, movies.description,
         movies.poster_filename, movies.rental_price
HAVING (@1 = '' OR bool_or(genres.genre_name ILIKE '%' || @1 || '%'))
ORDER BY movies.title;";

        data = db.Query(sql, titleSearch, genreSearch);
    }
    else
    {
        // Page opened normally: show everything
        var sql = @"SELECT movies.movie_id, movies.title, movies.description,
       movies.poster_filename, movies.rental_price,
       string_agg(genres.genre_name, ', ' ORDER BY genres.genre_name) AS genre_name
FROM movies
JOIN movie_genres ON movies.movie_id = movie_genres.movie_id
JOIN genres ON movie_genres.genre_id = genres.genre_id
GROUP BY movies.movie_id, movies.title, movies.description,
         movies.poster_filename, movies.rental_price
ORDER BY movies.title;";

        data = db.Query(sql);
    }
}

<h2 class="text-center mt-4 mb-4 py-2">Movie Rental Library</h2>

<form method="post" class="d-flex flex-wrap align-items-end gap-3 mb-4">
    <div>
        <label for="titleSearch" class="form-label">Movie title</label>
        <input type="text" name="titleSearch" id="titleSearch" class="form-control" value="@titleSearch">
    </div>
    <div>
        <label for="genreSearch" class="form-label">Genre</label>
        <select name="genreSearch" id="genreSearch" class="form-select">
            <option value="">All genres</option>
            @foreach (var g in genres)
            {
                <option value="@g.genre_name" selected="@(g.genre_name == genreSearch)">@g.genre_name</option>
            }
        </select>
    </div>
    <div>
        <button type="submit" class="btn btn-primary">Search</button>
    </div>
    <div class="ms-auto">
        <a href="/Movies/Create" class="btn btn-primary">Create</a>
    </div>
</form>

@if (IsPost)
{
    <p class="text-muted">
        Showing results for title "@titleSearch" and genre "@genreSearch"
    </p>
}

<div class="row row-cols-1 row-cols-md-3 g-3">
    @foreach (var row in data)
    {
        <div class="col">
            <div class="card h-100">
                <div class="card-header">
                    <p class="text-center fw-bold">@row.title - @row.genre_name</p>
                </div>
                <div class="card-body">
                    <img src="@Url.Content("~/Content/images/poster-placeholder.svg")" alt="@row.poster_filename" class="card-img-top">
                    <p>@row.description</p>
                </div>
                <div class="card-footer d-flex justify-content-between  ">
                    <p>$ @row.rental_price</p>
                    <a href="/Movies/Details?id=@row.movie_id" class="btn btn-primary">More Details</a>
                </div>
            </div>
        </div>
    }
</div>
