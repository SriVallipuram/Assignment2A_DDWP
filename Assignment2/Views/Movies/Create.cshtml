@{
    ViewBag.Title = "Create Page";
}
<h2>Create</h2>
<div>
    <h1>Create a New Movie</h1>
    <form method="post" class="border border-primary rounded p-3">
        <div class="row g-3">
            <div class="col-md-6">
                <label for="title" class="form-label">Movie Title</label>
                <input type="text" name="title" id="title" class="form-control">
            </div>
            <div class="col-md-6">
                <label for="release_year" class="form-label">Release Year</label>
                <input type="text" name="release_year" id="release_year" class="form-control">
            </div>
            <div class="col-md-6">
                <label for="runtime_minutes" class="form-label">Runtime (minutes)</label>
                <input type="number"step="0.1" min="0" name="runtime_minutes" id="runtime_minutes" class="form-control">
            </div>
            <div class="col-md-6">
                <label for="classification" class="form-label">Classification</label>
                <input type="text" name="classification" id="classification" class="form-control">
            </div>
            <div class="col-md-6">
                <label for="rental_price" class="form-label">Rental Price</label>
                <input type="number" step="0.01" min="0" name="rental_price" id="rental_price" class="form-control">
            </div>
            <div class="col-md-6">
                <label for="poster_filename" class="form-label">Poster Filename</label>
                <input type="text" name="poster_filename" id="poster_filename" class="form-control">
            </div>
            <div class="col-12">
                <label for="description" class="form-label">Description</label>
                <textarea name="description" id="description" rows="3" class="form-control"></textarea>
            </div>
            <div class="col-12 d-flex justify-content-end gap-2">
                <a href="/Movies/Index" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-primary">Save</button>
            </div>
        </div>
    </form>
</div>
